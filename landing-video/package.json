{
  "name": "sayanything-landing-video",
  "version": "1.0.0",
  "private": true,
  "description": "Generated hero background loop for the sayAnything website (Remotion + three.js)",
  "scripts": {
    "preview": "remotion studio",
    "render:hero": "remotion render SignalLoop out/hero-loop.mp4 --crf=25",
    "render:poster": "remotion still SignalLoop out/hero-poster.jpg --frame=0 --image-format=jpeg --jpeg-quality=88",
    "typecheck": "tsc --noEmit",
    "render:cover": "remotion still SignalLoopCover out/signal-cover.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.535",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.535",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "typescript": "5.9.3"
  }
}
